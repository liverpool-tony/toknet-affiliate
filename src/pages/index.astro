---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedPosts } from '../content/utils';

const posts = await getSortedPosts();
const latestPosts = posts.slice(0, 12);

// ブルーオーシャン特集記事（戦略v2.0の集中カテゴリ）
const featuredSlugs = [
  'ai-glasses-buying-guide-2026',
  'ai-voice-recorder-buying-guide-2026',
  'ray-ban-meta-japan-guide-2026',
  'plaud-note-pro-review-2026',
  'mobile-monitor-recommend-2026',
  'pocketalk-s2-review-2026',
];
const featuredPosts = featuredSlugs
  .map(slug => posts.find(p => p.slug === slug))
  .filter(Boolean);

const featuredMeta = [
  { emoji: '👓', label: 'AIグラス', color: '#6366f1' },
  { emoji: '🎙️', label: 'AIボイスレコーダー', color: '#0891b2' },
  { emoji: '🕶️', label: 'Ray-Ban Meta', color: '#7c3aed' },
  { emoji: '📝', label: 'PLAUD NOTE Pro', color: '#059669' },
  { emoji: '🖥️', label: 'モバイルモニター', color: '#d97706' },
  { emoji: '🌐', label: 'AI翻訳機', color: '#dc2626' },
];
---

<BaseLayout title="AI共創レビュー研究所 | AIガジェット専門の比較・レビューサイト" description="AIグラス・AIボイスレコーダー・AI翻訳機など最新AIガジェットを徹底比較。PLAUD NOTE・Ray-Ban Meta・XREAL・ポケトークの実機レビューと選び方ガイド。AIと人間の共創で透明性の高い情報をお届けします。">

  <!-- ヒーローセクション -->
  <section style="text-align: center; padding: 48px 0 28px;">
    <h1 style="font-size: 36px; font-weight: 800; margin-bottom: 16px; letter-spacing: -0.5px;">
      <span style="color: var(--color-primary);">AIガジェット</span>専門の<br>比較・レビューサイト
    </h1>
    <p style="font-size: 18px; color: var(--color-text-secondary); max-width: 640px; margin: 0 auto 24px;">
      AIグラス・AIボイスレコーダー・AI翻訳機など、次世代AIデバイスを徹底比較。<br>
      実機データと専門家の視点で、あなたに最適な1台を見つけます。
    </p>

    <!-- 🔥 今すぐ読める注目記事（ファーストビューCTA） -->
    <div style="background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); border-radius: 12px; padding: 20px 24px; max-width: 680px; margin: 0 auto 24px; text-align: left;">
      <p style="color: rgba(255,255,255,0.85); font-size: 12px; font-weight: 600; margin-bottom: 8px; letter-spacing: 0.5px;">🔥 まず読むべき1本</p>
      <a href="/articles/ai-glasses-buying-guide-2026/" style="text-decoration: none; display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 32px;">👓</span>
        <div>
          <p style="color: white; font-size: 16px; font-weight: 700; margin-bottom: 4px; line-height: 1.4;">AIグラス おすすめ 2026｜XREAL・Ray-Ban Meta・Even G2 徹底比較</p>
          <p style="color: rgba(255,255,255,0.8); font-size: 13px;">5製品を価格・機能・AI性能で比較。あなたに合う1台が3分でわかる →</p>
        </div>
      </a>
    </div>

    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a href="/category/wearable/" style="background: var(--color-primary); color: white; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 500;">👓 AIグラス・ウェアラブル</a>
      <a href="/category/software/" style="background: var(--color-primary); color: white; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 500;">🎙️ AIツール・ソフト</a>
      <a href="/category/monitors/" style="background: var(--color-primary); color: white; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 500;">🖥️ モバイルモニター</a>
      <a href="/category/laptop-pc/" style="background: var(--color-primary); color: white; padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 500;">💻 コスパPC</a>
    </div>
  </section>

  <!-- 特集：ブルーオーシャン記事 -->
  <section style="padding: 40px 0;">
    <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 8px;">📌 編集部のおすすめ</h2>
    <p style="font-size: 14px; color: var(--color-text-secondary); margin-bottom: 24px;">「どれを買えばいいかわからない」を解決。比較表・料金・実機データで、3分で最適解が見つかります。</p>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px;">
      {featuredPosts.map((post, i) => (
        <article style="border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden; transition: box-shadow 0.2s; position: relative;">
          <a href={`/articles/${post.slug}/`} style="text-decoration: none; color: inherit; display: block;">
            <div style={`background: ${featuredMeta[i]?.color || 'var(--color-primary)'}; padding: 16px 20px; display: flex; align-items: center; gap: 10px;`}>
              <span style="font-size: 24px;">{featuredMeta[i]?.emoji || '📱'}</span>
              <span style="color: white; font-size: 12px; font-weight: 600; background: rgba(255,255,255,0.2); padding: 3px 10px; border-radius: 4px;">
                {featuredMeta[i]?.label || post.data.category}
              </span>
            </div>
            <div style="padding: 20px;">
              <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 8px; line-height: 1.4;">
                {post.data.title}
              </h3>
              <p style="font-size: 13px; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 12px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {post.data.description}
              </p>
              <span style="font-size: 13px; color: var(--color-primary); font-weight: 600;">比較表と結論を見る →</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- 最新記事 -->
  <section style="padding: 40px 0;">
    <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 24px;">最新記事</h2>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px;">
      {latestPosts.map(post => (
        <article style="border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden; transition: box-shadow 0.2s;">
          <a href={`/articles/${post.slug}/`} style="text-decoration: none; color: inherit; display: block;">
            {post.data.products?.[0]?.image && (
              <img src={post.data.products[0].image} alt={post.data.title} style="width: 100%; height: 200px; object-fit: cover;" />
            )}
            <div style="padding: 20px;">
              <div style="display: flex; gap: 8px; margin-bottom: 8px;">
                <span style="background: var(--color-primary); color: white; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 500;">
                  {post.data.category}
                </span>
                {post.data.aiAssisted && (
                  <span style="background: var(--color-bg-secondary); color: var(--color-text-secondary); padding: 2px 8px; border-radius: 4px; font-size: 11px;">
                    AI共創
                  </span>
                )}
              </div>
              <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 8px; line-height: 1.4;">
                {post.data.title}
              </h3>
              <p style="font-size: 13px; color: var(--color-text-secondary); line-height: 1.5; margin-bottom: 12px;">
                {post.data.description}
              </p>
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <span style="font-size: 12px; color: var(--color-text-secondary);">
                  {new Date(post.data.pubDate).toLocaleDateString('ja-JP')}
                </span>
                {post.data.products?.[0]?.rating && (
                  <span style="font-size: 13px; color: var(--color-accent);">
                    ⭐ {post.data.products[0].rating}/5
                  </span>
                )}
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- このサイトについて -->
  <section style="padding: 60px 0; background: var(--color-bg-secondary); border-radius: 16px; margin: 40px 0; padding: 40px;">
    <h2 style="font-size: 24px; font-weight: 700; margin-bottom: 16px;">AI共創レビュー研究所とは</h2>
    <p style="font-size: 15px; color: var(--color-text-secondary); line-height: 1.8; margin-bottom: 16px;">
      当サイトは、<strong>AIグラス・AIボイスレコーダー・AI翻訳機</strong>など次世代AIガジェットに特化した比較・レビューサイトです。
      生成AIと人間の専門家が共創し、実機データと最新トレンドを掛け合わせた分析を行っています。
    </p>
    <p style="font-size: 15px; color: var(--color-text-secondary); line-height: 1.8; margin-bottom: 24px;">
      すべての記事にはAI使用を明記し、透明性を確保しています。
      アフィリエイト収入によって運営されていますが、商品の評価は公正に行っています。
    </p>
    <a href="/about/" style="display: inline-block; background: var(--color-primary); color: white; padding: 10px 24px; border-radius: 8px; font-size: 14px; font-weight: 500; text-decoration: none;">
      詳しく見る
    </a>
  </section>

</BaseLayout>
